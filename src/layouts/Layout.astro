---
import '../styles/global.css';
import type { Lang } from '../i18n/content';
import {
  buildCanonicalUrl,
  buildStructuredDataGraph,
  getSeoCopy,
  resolveSiteOrigin,
  serializeSafeJsonLd,
} from '../utils/seo';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  lang?: Lang;
  title: string;
  description: string;
  subPath?: string;
  ogType?: 'profile' | 'article' | 'website';
  ogImage?: string;
  ogImageAlt?: string;
  showParticles?: boolean;
  extraJsonLd?: Record<string, unknown>;
}

const {
  lang = 'en',
  title,
  description,
  subPath = '',
  ogType = 'profile',
  ogImage,
  ogImageAlt,
  showParticles = true,
  extraJsonLd,
} = Astro.props;
const dir = lang === 'fa' ? 'rtl' : 'ltr';
const siteOrigin = resolveSiteOrigin(Astro.url);
const canonicalUrl = buildCanonicalUrl(siteOrigin, lang, subPath);
const enUrl = buildCanonicalUrl(siteOrigin, 'en', subPath);
const faUrl = buildCanonicalUrl(siteOrigin, 'fa', subPath);
const defaultPortraitUrl = `${siteOrigin}/images/mohammad-pouhassani.jpg`;
const resolvedOgImage = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : `${siteOrigin}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`
  : defaultPortraitUrl;
const seoCopy = getSeoCopy(lang);
const resolvedOgAlt = ogImageAlt ?? seoCopy.portraitAlt;
const ogLocale = lang === 'fa' ? 'fa_IR' : 'en_US';
const ogLocaleAlt = lang === 'fa' ? 'en_US' : 'fa_IR';
const jsonLd = serializeSafeJsonLd(buildStructuredDataGraph(siteOrigin, lang));
const extraSerializedJsonLd = extraJsonLd ? serializeSafeJsonLd(extraJsonLd) : null;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var pref = localStorage.getItem('theme') || 'auto';
          var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var isDark = pref === 'dark' || (pref === 'auto' && systemDark);
          document.documentElement.classList.toggle('dark', isDark);
          document.documentElement.setAttribute('data-theme', pref);
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={seoCopy.personName} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="fa" href={faUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={seoCopy.personName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    {!ogImage && (
      <>
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="896" />
        <meta property="og:image:height" content="1200" />
      </>
    )}
    <meta property="og:image:alt" content={resolvedOgAlt} />
    <meta property="profile:first_name" content="Mohammad" />
    <meta property="profile:last_name" content="Pouhassani" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={resolvedOgAlt} />

    <meta name="theme-color" content="#F7F5F9" />
    <script type="application/ld+json" set:html={jsonLd} />
    {extraSerializedJsonLd && (
      <script type="application/ld+json" set:html={extraSerializedJsonLd} />
    )}
  </head>
  <body>
    {showParticles && (
      <canvas
        id="particle-stage"
        data-testid="particle-stage"
        aria-hidden="true"
        class="fixed inset-0 w-full h-full z-[5] pointer-events-none block"
      ></canvas>
    )}
    <script>
      const canvas = document.getElementById('particle-stage') as HTMLCanvasElement | null;
      if (canvas) {
        import('../scripts/particles').then(({ mountParticles }) => {
          mountParticles(canvas);
        });
      }
    </script>
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
