---
import { localizeBlogPosts } from '../data/blog';
import { content, type Lang } from '../i18n/content';
import { formatBlogDate } from '../utils/blog';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const dir = t.dir;
const blogPrefix = lang === 'fa' ? '/fa/blog' : '/blog';
const posts = localizeBlogPosts(lang);
const leadPost = posts.find((p) => p.featured) ?? posts[0];
const secondaryPosts = posts.filter((p) => p.slug !== leadPost.slug);
const arrow = dir === 'rtl' ? '←' : '→';
---

<section
  id="blog"
  class="scroll-mt-20 bg-fog/35 px-6 md:px-10 py-24 md:py-32 border-t border-ink/10"
>
  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <p class="font-mono text-xs text-accent font-medium mb-3">
          {t.blog.eyebrow}
        </p>
        <h2 class="font-display text-clamp-h2 tracking-tightest leading-none text-balance">
          {t.blog.title}
        </h2>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-4">
        <p class="max-w-sm text-graphite text-sm md:text-base leading-relaxed">
          {t.blog.intro}
        </p>
        <a
          href={blogPrefix}
          class="inline-flex items-center gap-2 text-xs font-medium bg-ink text-paper rounded-full px-4 py-2.5 hover:bg-accent hover:text-white transition-colors duration-200 whitespace-nowrap shrink-0 self-start md:self-auto"
        >
          <span>{t.blog.allArticles}</span>
          <span aria-hidden="true">{arrow}</span>
        </a>
      </div>
    </div>

    {/* Lead featured article */}
    <article class="rounded-2xl border border-ink/10 bg-chalk overflow-hidden mb-8">
      <a
        href={`${blogPrefix}/${leadPost.slug}`}
        class="group grid grid-cols-1 lg:grid-cols-12 items-stretch"
      >
        <div class="lg:col-span-5 aspect-[4/3] lg:aspect-auto lg:min-h-[300px] bg-fog overflow-hidden">
          <img
            src={leadPost.coverImage}
            alt={leadPost.coverAlt}
            loading="lazy"
            referrerPolicy="no-referrer"
            class="w-full h-full object-cover transition-transform duration-500 ease-out-quart group-hover:scale-[1.03]"
          />
        </div>
        <div class="lg:col-span-7 p-6 sm:p-8 md:p-10 flex flex-col justify-between gap-6">
          <div>
            <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-graphite mb-3 tabular-nums">
              <span class="text-accent font-medium">{t.blog.featuredLabel}</span>
              <span aria-hidden="true">·</span>
              <span>{t.blog.categories[leadPost.category]}</span>
              <span aria-hidden="true">·</span>
              <time datetime={leadPost.publishedAt}>
                {formatBlogDate(leadPost.publishedAt, lang)}
              </time>
              <span aria-hidden="true">·</span>
              <span>
                {leadPost.readingMinutes} {t.blog.minRead}
              </span>
            </div>
            <h3 class="font-display text-2xl sm:text-3xl tracking-tightest leading-tight text-balance group-hover:text-accent transition-colors duration-200">
              {leadPost.title}
            </h3>
            <p class="text-graphite text-sm md:text-base leading-relaxed mt-3 max-w-2xl">
              {leadPost.excerpt}
            </p>
          </div>
          <div class="inline-flex items-center gap-2 text-xs font-medium text-ink group-hover:text-accent transition-colors duration-200">
            <span>{t.blog.readArticle}</span>
            <span aria-hidden="true">{arrow}</span>
          </div>
        </div>
      </a>
    </article>

    {/* Secondary 2x2 grid covering the remaining 4 articles */}
    <div class="grid sm:grid-cols-2 gap-6 items-stretch">
      {secondaryPosts.map((post) => (
        <article class="h-full rounded-2xl border border-ink/10 bg-chalk overflow-hidden flex flex-col">
          <a
            href={`${blogPrefix}/${post.slug}`}
            class="group flex-1 flex flex-col"
          >
            <div class="aspect-[4/3] w-full bg-fog overflow-hidden">
              <img
                src={post.coverImage}
                alt={post.coverAlt}
                loading="lazy"
                referrerPolicy="no-referrer"
                class="w-full h-full object-cover transition-transform duration-500 ease-out-quart group-hover:scale-[1.03]"
              />
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between gap-4">
              <div>
                <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-graphite mb-2.5 tabular-nums">
                  <span class="text-accent font-medium">
                    {t.blog.categories[post.category]}
                  </span>
                  <span aria-hidden="true">·</span>
                  <time datetime={post.publishedAt}>
                    {formatBlogDate(post.publishedAt, lang)}
                  </time>
                  <span aria-hidden="true">·</span>
                  <span>
                    {post.readingMinutes} {t.blog.minRead}
                  </span>
                </div>
                <h3 class="font-display text-xl tracking-tightest leading-snug text-balance group-hover:text-accent transition-colors duration-200">
                  {post.title}
                </h3>
                <p class="text-graphite text-sm leading-relaxed mt-2 line-clamp-2">
                  {post.excerpt}
                </p>
              </div>
              <div class="inline-flex items-center gap-2 text-xs font-medium text-ink group-hover:text-accent transition-colors duration-200 pt-2 border-t border-ink/10">
                <span>{t.blog.readArticle}</span>
                <span aria-hidden="true">{arrow}</span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
