---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { localizeBlogPosts, type BlogPost } from '../data/blog';
import { content, type Lang } from '../i18n/content';
import { formatBlogDate, getRelatedPosts } from '../utils/blog';
import {
  buildBlogPostStructuredData,
  resolveSiteOrigin,
  sanitizeExternalUrl,
} from '../utils/seo';

interface Props {
  lang: Lang;
  post: BlogPost;
}

const { lang, post } = Astro.props;
const t = content[lang];
const dir = t.dir;
const localized = post[lang];
const blogPrefix = lang === 'fa' ? '/fa/blog' : '/blog';
const subPath = `/blog/${post.slug}`;
const backArrow = dir === 'rtl' ? '→' : '←';
const fwdArrow = dir === 'rtl' ? '←' : '→';

const origin = resolveSiteOrigin(Astro.url);
const extraJsonLd = buildBlogPostStructuredData(origin, lang, {
  slug: post.slug,
  title: localized.title,
  description: localized.excerpt,
  publishedAt: post.publishedAt,
  coverImage: post.coverImage,
});

const relatedPosts = getRelatedPosts(localizeBlogPosts(lang), post.slug, 2);
const safeLinks = localized.links
  .map((item) => ({
    ...item,
    safeUrl: sanitizeExternalUrl(item.url),
  }))
  .filter((item): item is typeof item & { safeUrl: string } => Boolean(item.safeUrl));
---

<Layout
  lang={lang}
  title={`${localized.title} — ${t.footer.name}`}
  description={localized.excerpt}
  subPath={subPath}
  ogType="article"
  ogImage={post.coverImage}
  ogImageAlt={localized.coverAlt}
  showParticles={false}
  extraJsonLd={extraJsonLd}
>
  <Header lang={lang} subPath={subPath} />

  <div
    dir={dir}
    aria-hidden="true"
    class="fixed top-16 left-0 right-0 h-[2px] z-40 pointer-events-none bg-transparent"
  >
    <div
      id="reading-progress"
      class="h-full bg-accent transition-[width] duration-75"
      style="width: 0%"
    ></div>
  </div>

  <main id="top" class="pt-28 pb-24 px-6 md:px-10">
    <article id="article-body" class="mx-auto max-w-3xl">
      <a
        href={blogPrefix}
        class="inline-flex items-center gap-2 font-mono text-xs text-graphite hover:text-accent transition-colors duration-200 mb-8"
      >
        <span aria-hidden="true">{backArrow}</span>
        <span>{t.blog.backToBlog}</span>
      </a>

      <header>
        <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-graphite tabular-nums">
          <span class="text-accent font-medium">
            {t.blog.categories[post.category]}
          </span>
          <span aria-hidden="true">·</span>
          <time datetime={post.publishedAt}>
            {formatBlogDate(post.publishedAt, lang)}
          </time>
          <span aria-hidden="true">·</span>
          <span>
            {post.readingMinutes} {t.blog.minRead}
          </span>
        </div>

        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl tracking-tightest leading-[1.12] text-balance mt-4">
          {localized.title}
        </h1>

        <p class="text-graphite text-base md:text-xl leading-relaxed mt-5">
          {localized.subtitle}
        </p>
      </header>

      <figure class="mt-10">
        <div class="rounded-2xl border border-ink/10 bg-fog overflow-hidden aspect-[4/3]">
          <img
            src={post.coverImage}
            alt={localized.coverAlt}
            referrerPolicy="no-referrer"
            class="w-full h-full object-cover"
          />
        </div>
        <figcaption class="font-mono text-xs text-graphite mt-3 leading-relaxed">
          {localized.coverCaption}
        </figcaption>
      </figure>

      <aside class="mt-10 rounded-2xl border border-ink/10 bg-chalk p-6 md:p-7">
        <h2 class="font-mono text-xs text-accent font-medium mb-4">
          {t.blog.keyTakeaways}
        </h2>
        <ul class="space-y-2.5 text-sm md:text-base text-ink/90 leading-relaxed">
          {localized.keyPoints.map((point) => (
            <li class="flex items-start gap-2.5">
              <span
                aria-hidden="true"
                class="w-1.5 h-1.5 rounded-full bg-accent mt-[0.55em] shrink-0"
              ></span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </aside>

      <div class="mt-12 space-y-12">
        {localized.sections.map((section) => {
          const figureHref = sanitizeExternalUrl(section.figure?.linkUrl);
          return (
            <section class="space-y-4">
              <h2 class="font-display text-2xl md:text-3xl tracking-tightest leading-snug text-balance">
                {section.heading}
              </h2>

              {section.paragraphs.map((paragraph) => (
                <p class="text-ink/90 text-base md:text-[17px] leading-[1.85]">
                  {paragraph}
                </p>
              ))}

              {section.codeSnippet && (
                <div
                  dir="ltr"
                  class="mt-6 rounded-2xl border border-ink/15 bg-[#12101A] text-[#ECE9F2] overflow-hidden"
                >
                  <div class="px-4 py-2.5 border-b border-white/10 font-mono text-xs text-[#A78BFA]">
                    {section.codeSnippet.title}
                  </div>
                  <pre class="p-4 md:p-5 overflow-x-auto font-mono text-xs sm:text-[13px] leading-relaxed"><code>{section.codeSnippet.code}</code></pre>
                </div>
              )}

              {section.figure && (
                <figure class="mt-8">
                  <div class="rounded-2xl border border-ink/10 bg-fog overflow-hidden aspect-[16/10]">
                    <img
                      src={section.figure.src}
                      alt={section.figure.alt}
                      referrerPolicy="no-referrer"
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <figcaption class="mt-3 flex flex-wrap items-center justify-between gap-3 font-mono text-xs text-graphite leading-relaxed">
                    <span>{section.figure.caption}</span>
                    {figureHref && section.figure.linkLabel && (
                      <a
                        href={figureHref}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-accent font-medium hover:underline whitespace-nowrap shrink-0"
                      >
                        {section.figure.linkLabel} {fwdArrow}
                      </a>
                    )}
                  </figcaption>
                </figure>
              )}
            </section>
          );
        })}
      </div>

      {safeLinks.length > 0 && (
        <section class="mt-14 pt-10 border-t border-ink/10">
          <h2 class="font-display text-2xl tracking-tightest mb-5">
            {t.blog.referencesHeading}
          </h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {safeLinks.map((item) => (
              <a
                href={item.safeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group rounded-2xl border border-ink/10 bg-chalk p-5 hover:border-accent/40 transition-colors duration-200 flex flex-col justify-between gap-3"
              >
                <div>
                  <div class="font-display text-base font-medium text-ink group-hover:text-accent transition-colors flex items-center justify-between gap-2">
                    <span>{item.label}</span>
                    <span aria-hidden="true" class="text-xs shrink-0">
                      ↗
                    </span>
                  </div>
                  <p class="text-graphite text-xs sm:text-sm leading-relaxed mt-1.5">
                    {item.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {relatedPosts.length > 0 && (
        <section class="mt-14 pt-10 border-t border-ink/10">
          <h2 class="font-display text-2xl tracking-tightest mb-6">
            {t.blog.relatedHeading}
          </h2>
          <div class="grid sm:grid-cols-2 gap-6">
            {relatedPosts.map((item) => (
              <article class="h-full rounded-2xl border border-ink/10 bg-chalk overflow-hidden flex flex-col">
                <a
                  href={`${blogPrefix}/${item.slug}`}
                  class="group flex-1 flex flex-col"
                >
                  <div class="aspect-[4/3] w-full bg-fog overflow-hidden">
                    <img
                      src={item.coverImage}
                      alt={item.coverAlt}
                      loading="lazy"
                      referrerPolicy="no-referrer"
                      class="w-full h-full object-cover transition-transform duration-500 ease-out-quart group-hover:scale-[1.03]"
                    />
                  </div>
                  <div class="p-5 flex-1 flex flex-col justify-between gap-3">
                    <div>
                      <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-graphite mb-2 tabular-nums">
                        <span class="text-accent font-medium">
                          {t.blog.categories[item.category]}
                        </span>
                        <span aria-hidden="true">·</span>
                        <span>
                          {item.readingMinutes} {t.blog.minRead}
                        </span>
                      </div>
                      <h3 class="font-display text-lg tracking-tightest leading-snug text-balance group-hover:text-accent transition-colors duration-200">
                        {item.title}
                      </h3>
                    </div>
                    <span class="inline-flex items-center gap-1.5 text-xs font-medium text-ink group-hover:text-accent transition-colors">
                      <span>{t.blog.readArticle}</span>
                      <span aria-hidden="true">{fwdArrow}</span>
                    </span>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>

  <Footer lang={lang} />

  <script>
    import { computeReadingProgress } from '../utils/blog';

    const progressEl = document.getElementById('reading-progress');
    const articleEl = document.getElementById('article-body');

    function updateProgress() {
      if (!progressEl || !articleEl) return;
      const ratio = computeReadingProgress(
        window.scrollY,
        articleEl.offsetTop,
        articleEl.offsetHeight,
        window.innerHeight,
      );
      progressEl.style.width = `${Math.round(ratio * 1000) / 10}%`;
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
    updateProgress();
  </script>
</Layout>
