---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const dir = t.dir;
const arrow = dir === 'rtl' ? '←' : '→';
const hoverTranslate = dir === 'rtl' ? 'group-hover:-translate-x-2' : 'group-hover:translate-x-2';
---

<section id="services" class="px-6 md:px-10 py-28 md:py-36 border-t border-ink/10">
  <p class="font-mono text-[13px] uppercase tracking-widemono text-graphite mb-4">
    {t.services.eyebrow}
  </p>
  <h2 class="font-display text-clamp-h2 tracking-tightest leading-none mb-14">
    {t.services.title}
  </h2>

  <div class="divide-y divide-ink/10 border-t border-b border-ink/10">
    {t.services.items.map((service) => (
      <div class="group grid md:grid-cols-12 gap-4 md:gap-10 py-8 md:py-10 items-baseline">
        <h3 class={`md:col-span-4 font-display text-2xl md:text-3xl tracking-tightest transition-transform duration-300 ease-out-quart ${hoverTranslate}`}>
          {service.name}
        </h3>
        <p class="md:col-span-7 text-graphite text-sm md:text-base leading-relaxed">
          {service.detail}
        </p>
        <span class="md:col-span-1 hidden md:flex justify-end font-mono text-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          {arrow}
        </span>
      </div>
    ))}
  </div>
</section>
