---
import { content, type Lang } from '../i18n/content';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<header class="fixed top-0 left-0 right-0 z-50 mix-blend-normal">
  <div class="flex items-center justify-between px-6 md:px-10 py-5 backdrop-blur-sm bg-paper/70 border-b border-ink/10">
    <a href="#top" class="font-display text-lg tracking-tightest font-semibold">
      {t.header.wordmark}<span class="text-graphite">.</span>
    </a>

    <nav class="hidden md:flex items-center gap-8 font-mono text-[13px] uppercase tracking-widemono">
      {t.header.nav.map((link) => (
        <a
          href={link.href}
          class="relative pb-1 after:absolute after:start-0 after:-bottom-0.5 after:h-[1.5px] after:w-0 after:bg-ink after:transition-all after:duration-300 after:ease-out-quart hover:after:w-full"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-5">
      <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-widemono">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-ink opacity-40"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-ink"></span>
        </span>
        {t.header.available}
      </div>
      <a
        href={t.header.langSwitch.href}
        class="font-mono text-[11px] uppercase tracking-widemono border border-ink/20 rounded-full px-3 py-1 hover:border-ink/60 transition-colors duration-300"
      >
        {t.header.langSwitch.label}
      </a>
      <ThemeToggle lang={lang} />
    </div>

    <button
      id="menu-toggle"
      class="md:hidden font-mono text-[13px] uppercase tracking-widemono border border-ink/30 rounded-full px-4 py-1.5"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      {t.header.menu}
    </button>
  </div>

  <div
    id="mobile-menu"
    class="md:hidden hidden flex-col gap-1 bg-paper border-b border-ink/10 px-6 py-6"
  >
    {t.header.nav.map((link) => (
      <a href={link.href} class="font-display text-3xl py-2 tracking-tightest">
        {link.label}
      </a>
    ))}
    <div class="flex items-center justify-between mt-4">
      <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-widemono text-graphite">
        <span class="relative inline-flex rounded-full h-2 w-2 bg-ink"></span>
        {t.header.available}
      </div>
      <a
        href={t.header.langSwitch.href}
        class="font-mono text-[11px] uppercase tracking-widemono border border-ink/20 rounded-full px-3 py-1"
      >
        {t.header.langSwitch.label}
      </a>
    </div>
    <div class="mt-4">
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('flex');
    menu?.classList.toggle('hidden', isOpen);
    menu?.classList.toggle('flex', !isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
