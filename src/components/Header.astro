---
import { content, getCvAsset, type Lang } from '../i18n/content';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  subPath?: string;
}

const { lang, subPath = '' } = Astro.props;
const t = content[lang];
const cvAsset = getCvAsset(lang);
const homePrefix = lang === 'fa' ? '/fa' : '/';
const isHome = !subPath;
const cleanSub = subPath ? `/${subPath.replace(/^\/+|\/+$/g, '')}` : '';
const resolveNavHref = (href: string) => {
  if (!href.startsWith('#')) return href;
  return isHome ? href : `${homePrefix}${href}`;
};
const switchHref = cleanSub
  ? lang === 'fa'
    ? cleanSub
    : `/fa${cleanSub}`
  : t.header.langSwitch.href;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-paper border-b border-ink/10">
  <div class="mx-auto max-w-7xl flex items-center justify-between gap-6 px-6 md:px-10 h-16">
    {/* Zone 1: Single-line Brand Wordmark */}
    <a
      href={isHome ? '#top' : homePrefix}
      class="font-display text-base sm:text-lg tracking-tightest font-semibold whitespace-nowrap shrink-0"
    >
      {t.header.wordmark}<span class="text-accent">.</span>
    </a>

    {/* Zone 2: Concise single-line navigation links */}
    <nav
      aria-label="Primary"
      class="hidden lg:flex items-center gap-7 text-sm font-medium text-graphite"
    >
      {t.header.nav.map((link) => {
        const isBlogActive = !isHome && !link.href.startsWith('#') && cleanSub.startsWith('/blog');
        return (
          <a
            href={resolveNavHref(link.href)}
            aria-current={isBlogActive ? 'page' : undefined}
            class={`relative py-1 whitespace-nowrap shrink-0 hover:text-ink transition-colors duration-200 after:absolute after:start-0 after:bottom-0 after:h-[1.5px] after:bg-accent after:transition-all after:duration-200 ${
              isBlogActive
                ? 'text-ink after:w-full'
                : 'after:w-0 hover:after:w-full'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    {/* Zone 3: Compact Utilities + Primary CV CTA */}
    <div class="hidden lg:flex items-center gap-3 shrink-0">
      <a
        href={switchHref}
        class="font-mono text-xs border border-ink/15 rounded-full px-3 py-1.5 text-graphite hover:text-ink hover:border-ink/40 transition-colors duration-200 whitespace-nowrap shrink-0"
      >
        {t.header.langSwitch.label}
      </a>
      <ThemeToggle lang={lang} />
      <a
        href={cvAsset.url}
        download={cvAsset.filename}
        aria-label={t.cv.ariaLabel}
        class="inline-flex items-center gap-2 text-xs font-medium bg-accent text-white rounded-full px-4 py-2 hover:opacity-90 transition-opacity duration-200 whitespace-nowrap shrink-0"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"
          />
        </svg>
        <span>{t.cv.download}</span>
      </a>
    </div>

    {/* Mobile action + drawer trigger */}
    <div class="flex lg:hidden items-center gap-2 shrink-0">
      <a
        href={cvAsset.url}
        download={cvAsset.filename}
        aria-label={t.cv.ariaLabel}
        class="inline-flex items-center gap-1.5 text-xs font-medium bg-accent text-white rounded-full px-3.5 py-2 whitespace-nowrap shrink-0"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"
          />
        </svg>
        <span>{t.cv.download}</span>
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="text-xs font-medium border border-ink/20 rounded-full px-3.5 py-2 text-ink hover:border-ink/50 transition-colors duration-200 whitespace-nowrap shrink-0"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        {t.header.menu}
      </button>
    </div>
  </div>

  {/* Mobile drawer */}
  <div
    id="mobile-menu"
    class="lg:hidden hidden flex-col gap-1 bg-paper border-t border-ink/10 px-6 py-6"
  >
    {t.header.nav.map((link) => (
      <a
        href={resolveNavHref(link.href)}
        class="font-display text-2xl py-2.5 tracking-tightest text-ink hover:text-accent transition-colors"
      >
        {link.label}
      </a>
    ))}
    <div class="flex items-center justify-between gap-4 pt-4 mt-2 border-t border-ink/10">
      <a
        href={switchHref}
        class="text-xs font-medium border border-ink/20 rounded-full px-3.5 py-2 text-ink"
      >
        {t.header.langSwitch.label}
      </a>
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  function setMenuOpen(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    menu?.classList.toggle('flex', open);
    toggle?.setAttribute('aria-expanded', String(open));
  }

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('flex') ?? false;
    setMenuOpen(!isOpen);
  });

  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => setMenuOpen(false)),
  );

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('flex')) {
      setMenuOpen(false);
    }
  });
</script>
