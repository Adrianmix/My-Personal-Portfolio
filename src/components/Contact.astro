---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const [line1, line2] = t.contact.titleLines;
---

<section id="contact" class="bg-ink text-paper px-6 md:px-10 py-28 md:py-36">
  <p class="font-mono text-[13px] uppercase tracking-widemono text-paper/50 mb-6">
    {t.contact.eyebrow}
  </p>

  <h2 class="font-display text-clamp-hero leading-[0.92] tracking-tightest mb-10">
    {line1}
    <br />
    {line2}
  </h2>

  <a
    href={`mailto:${t.contact.email}`}
    dir="ltr"
    class="inline-block font-display text-2xl md:text-4xl tracking-tightest border-b-2 border-paper/30 hover:border-paper transition-colors duration-300 pb-1 mb-14"
  >
    {t.contact.email}
  </a>

  <div class="flex flex-wrap gap-x-8 gap-y-3 font-mono text-[13px] uppercase tracking-widemono text-paper/70">
    {t.contact.socials.map((s) => (
      <a href={s.href} class="hover:text-paper transition-colors duration-300">
        {s.label}
      </a>
    ))}
  </div>
</section>
