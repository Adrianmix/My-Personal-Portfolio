---
import { content, CV_ASSET, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const [line1, line2] = t.contact.titleLines;
---

<section id="contact" class="scroll-mt-20 bg-ink text-paper px-6 md:px-10 py-24 md:py-32">
  <div class="relative z-10 mx-auto max-w-7xl">
    <p class="font-mono text-xs text-paper/60 mb-5">
      {t.contact.eyebrow}
    </p>

    <h2 class="font-display text-[clamp(2.5rem,6vw,5.25rem)] leading-[0.95] tracking-tightest mb-10 text-balance">
      {line1}
      <br />
      {line2}
    </h2>

    <div class="flex flex-wrap items-center gap-6 mb-14">
      <a
        href={`mailto:${t.contact.email}`}
        dir="ltr"
        class="inline-block font-display text-2xl md:text-4xl tracking-tightest border-b-2 border-paper/30 hover:border-accent hover:text-accent transition-colors duration-200 pb-1"
      >
        {t.contact.email}
      </a>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-6 pt-8 border-t border-paper/15">
      <div class="flex flex-wrap gap-x-8 gap-y-3 font-mono text-xs text-paper/75">
        {t.contact.socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-paper underline underline-offset-4 decoration-paper/20 hover:decoration-paper transition-colors duration-200"
          >
            {s.label}
          </a>
        ))}
      </div>

      <a
        href={CV_ASSET.url}
        download={CV_ASSET.filename}
        aria-label={t.cv.ariaLabel}
        class="inline-flex items-center gap-2 text-xs font-medium bg-paper text-ink rounded-full px-4 py-2.5 hover:bg-accent hover:text-white transition-colors duration-200 whitespace-nowrap"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"
          />
        </svg>
        <span>{t.cv.download}</span>
      </a>
    </div>
  </div>
</section>
