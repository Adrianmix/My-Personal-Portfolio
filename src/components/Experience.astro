---
import { content, getCvAsset, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const exp = t.experience;
const cvAsset = getCvAsset(lang);
---

<section id="experience" class="scroll-mt-20 px-6 md:px-10 py-24 md:py-32 border-t border-ink/10">
  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
      <div>
        <p class="font-mono text-xs text-accent font-medium mb-3">
          {exp.eyebrow}
        </p>
        <h2 class="font-display text-clamp-h2 tracking-tightest leading-none text-balance">
          {exp.title}
        </h2>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-4">
        <p class="max-w-sm text-graphite text-sm md:text-base leading-relaxed">
          {exp.intro}
        </p>
        <a
          href={cvAsset.url}
          download={cvAsset.filename}
          aria-label={t.cv.ariaLabel}
          class="inline-flex items-center gap-2 text-xs font-medium bg-ink text-paper rounded-full px-4 py-2.5 hover:bg-accent hover:text-white transition-colors duration-200 whitespace-nowrap shrink-0 self-start md:self-auto"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"
            />
          </svg>
          <span>{t.cv.download}</span>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-start">
      {/* Work History Timeline */}
      <div class="lg:col-span-7">
        <h3 class="font-mono text-xs text-graphite pb-4 border-b border-ink/10">
          {exp.workHeading}
        </h3>
        <div class="divide-y divide-ink/10">
          {exp.jobs.map((job) => (
            <article class="py-7 first:pt-6">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-3">
                <div>
                  <h4 class="font-display text-xl md:text-2xl tracking-tightest font-medium">
                    {job.role}
                  </h4>
                  <p class="text-sm text-graphite mt-0.5">
                    {job.company} · {job.location}
                  </p>
                </div>
                <span class="font-mono text-xs text-graphite tabular-nums shrink-0">
                  {job.period}
                </span>
              </div>
              <ul class="space-y-2 text-sm md:text-[15px] text-graphite leading-relaxed mt-4">
                {job.points.map((point) => (
                  <li class="flex items-start gap-2.5">
                    <span aria-hidden="true" class="text-accent mt-1.5 text-[10px] leading-none">
                      ▪
                    </span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>

      {/* Education, Languages & Technical Competencies */}
      <div class="lg:col-span-5 space-y-10">
        <div class="rounded-2xl border border-ink/10 bg-chalk p-6 md:p-7">
          <h3 class="font-mono text-xs text-graphite mb-4">
            {exp.educationHeading}
          </h3>
          <div>
            <h4 class="font-display text-lg md:text-xl font-medium tracking-tightest">
              {exp.education.degree}
            </h4>
            <p class="text-sm text-graphite mt-1">
              {exp.education.school}
            </p>
            <p class="font-mono text-xs text-graphite tabular-nums mt-2">
              {exp.education.period}
            </p>
          </div>

          <div class="mt-6 pt-5 border-t border-ink/10 flex flex-wrap gap-x-8 gap-y-2 text-sm">
            {exp.languages.map((langItem) => (
              <div>
                <span class="font-medium text-ink">{langItem.name}</span>
                <span class="text-graphite"> · {langItem.level}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-2xl border border-ink/10 bg-chalk p-6 md:p-7">
          <h3 class="font-mono text-xs text-graphite mb-5">
            {exp.skillsHeading}
          </h3>
          <dl class="space-y-4">
            {exp.skillGroups.map((group) => (
              <div class="pb-4 last:pb-0 border-b last:border-b-0 border-ink/10">
                <dt class="font-mono text-xs text-accent font-medium mb-1">
                  {group.label}
                </dt>
                <dd class="text-sm text-graphite leading-relaxed">
                  {group.items}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>
