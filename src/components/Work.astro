---
import WorkGrid from './WorkGrid';
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<section id="work" class="px-6 md:px-10 py-28 md:py-36 border-t border-ink/10">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
    <div>
      <p class="font-mono text-[13px] uppercase tracking-widemono text-graphite mb-4">
        {t.work.eyebrow}
      </p>
      <h2 class="font-display text-clamp-h2 tracking-tightest leading-none">
        {t.work.title}
      </h2>
    </div>
    <p class="max-w-sm text-graphite text-sm md:text-base leading-relaxed">
      {t.work.intro}
    </p>
  </div>

  <WorkGrid lang={lang} client:visible />
</section>
