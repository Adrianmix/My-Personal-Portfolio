---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const year = new Date().getFullYear();
---

<footer class="bg-ink text-paper/60 border-t border-paper/10 px-6 md:px-10 py-6">
  <div class="relative z-10 mx-auto max-w-7xl flex items-center justify-between font-mono text-xs">
    <span>&copy; {year} {t.footer.name}</span>
    <a href="#top" class="hover:text-paper transition-colors duration-200">
      {t.footer.backToTop}
    </a>
  </div>
</footer>
