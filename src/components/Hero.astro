---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const [line1, line2, line3] = t.hero.titleLines;
---

<section id="top" class="relative min-h-[100svh] flex flex-col justify-end overflow-hidden pt-32">
  <!-- Blob canvas wrapper: mix-blend-mode: difference lives here, so it
       inverts the headline text and any card it drifts across -->
  <div class="pointer-events-none absolute inset-0 blob-blend">
    <canvas id="hero-blob" class="w-full h-full"></canvas>
  </div>

  <div class="relative z-10 px-6 md:px-10">
    <p class="font-mono text-[13px] uppercase tracking-widemono text-graphite mb-4">
      {t.hero.eyebrow}
    </p>

    <h1 class="font-display font-semibold text-clamp-hero leading-[0.92] tracking-tightest">
      {line1}
      <br />
      {line2}
      <br />
      <span class="italic font-normal">{line3}</span>
    </h1>

    <p class="max-w-md mt-6 text-graphite text-base md:text-lg leading-relaxed">
      {t.hero.body}
    </p>

    <div class="flex flex-wrap items-center gap-4 mt-8">
      <a
        href="#work"
        class="font-mono text-[13px] uppercase tracking-widemono bg-ink text-paper px-6 py-3 rounded-full hover:bg-graphite transition-colors duration-300"
      >
        {t.hero.ctaPrimary}
      </a>
      <a
        href="#contact"
        class="font-mono text-[13px] uppercase tracking-widemono border border-ink/30 px-6 py-3 rounded-full hover:border-ink transition-colors duration-300"
      >
        {t.hero.ctaSecondary}
      </a>
    </div>
  </div>

  <div class="relative z-10 border-t border-ink/10 mt-16 overflow-hidden">
    <div class="marquee-track py-4 font-mono text-sm uppercase tracking-widemono text-graphite">
      {[...t.hero.roles, ...t.hero.roles].map((role) => (
        <span class="flex items-center gap-4 px-4 shrink-0">
          {role}
          <span aria-hidden="true">&bull;</span>
        </span>
      ))}
    </div>
  </div>
</section>

<script>
  import { mountBlob } from '../scripts/blob';

  const canvas = document.getElementById('hero-blob') as HTMLCanvasElement | null;
  if (canvas) {
    mountBlob(canvas);
  }
</script>
