---
import { content, CV_ASSET, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const [line1, line2, line3] = t.hero.titleLines;
---

<section id="top" class="pt-16 min-h-[100svh] flex flex-col justify-between overflow-hidden">
  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 md:px-10 py-10 md:py-14 flex-1 flex items-center">
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      {/* Typographic column */}
      <div class="lg:col-span-7">
        <p class="font-mono text-xs text-accent font-medium mb-5">
          {t.hero.eyebrow} · {t.hero.availability}
        </p>

        <h1 class="font-display font-semibold text-[clamp(2.5rem,5.5vw,4.75rem)] leading-[0.98] tracking-tightest text-balance">
          {line1}
          <br />
          {line2}
          <br />
          <span class="italic font-normal text-graphite">{line3}</span>
        </h1>

        <p class="max-w-xl mt-6 text-graphite text-base md:text-lg leading-relaxed">
          {t.hero.body}
        </p>

        <div class="flex flex-wrap items-center gap-3.5 mt-8">
          <a
            href="#work"
            class="inline-flex items-center justify-center text-sm font-medium bg-ink text-paper px-6 py-3 rounded-full hover:bg-accent hover:text-white transition-colors duration-200 whitespace-nowrap"
          >
            {t.hero.ctaPrimary}
          </a>
          <a
            href={CV_ASSET.url}
            download={CV_ASSET.filename}
            aria-label={t.cv.ariaLabel}
            class="inline-flex items-center gap-2 text-sm font-medium bg-paper/90 border border-ink/25 text-ink px-5 py-3 rounded-full hover:border-accent hover:text-accent transition-colors duration-200 whitespace-nowrap"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"
              />
            </svg>
            <span>{t.hero.ctaSecondary}</span>
          </a>
          <a
            href="#contact"
            class="text-sm font-medium text-graphite hover:text-ink underline underline-offset-4 decoration-ink/25 hover:decoration-accent px-2 py-2 transition-colors duration-200 whitespace-nowrap"
          >
            {t.hero.ctaTertiary}
          </a>
        </div>
      </div>

      {/* Open stage spacer for the scroll-reactive 3D particle sculpture */}
      <div class="lg:col-span-5" aria-hidden="true">
        <div class="relative h-[220px] sm:h-[260px] lg:h-[420px] w-full"></div>
      </div>
    </div>
  </div>

  {/* Clean editorial marquee divider */}
  <div class="hero-marquee-shell relative z-10 w-full border-t border-b border-ink/10 overflow-hidden bg-fog/35">
    <div class="marquee-track py-3.5 font-mono text-xs text-graphite">
      {[...t.hero.roles, ...t.hero.roles, ...t.hero.roles].map((role) => (
        <span class="flex items-center gap-4 px-4 shrink-0">
          <span>{role}</span>
          <span aria-hidden="true" class="text-accent">·</span>
        </span>
      ))}
    </div>
  </div>
</section>
