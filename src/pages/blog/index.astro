---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCatalog from '../../components/BlogCatalog';
import { content } from '../../i18n/content';

export const prerender = true;

const lang = 'en' as const;
const t = content[lang];
---

<Layout
  lang={lang}
  title={t.blog.pageTitle}
  description={t.blog.pageDescription}
  subPath="/blog"
  ogType="website"
  ogImage="/images/blog/portfolio-making.jpg"
  ogImageAlt={t.blog.title}
  showParticles={false}
>
  <Header lang={lang} subPath="/blog" />

  <main id="top" class="pt-28 pb-24 px-6 md:px-10">
    <div class="mx-auto max-w-7xl">
      <a
        href="/"
        class="inline-flex items-center gap-2 font-mono text-xs text-graphite hover:text-accent transition-colors duration-200 mb-8"
      >
        <span aria-hidden="true">←</span>
        <span>{t.blog.backToHome}</span>
      </a>

      <div class="max-w-3xl mb-12">
        <p class="font-mono text-xs text-accent font-medium mb-3">
          {t.blog.eyebrow}
        </p>
        <h1 class="font-display text-4xl sm:text-5xl tracking-tightest leading-[1.08] text-balance">
          {t.blog.title}
        </h1>
        <p class="text-graphite text-base md:text-lg leading-relaxed mt-4">
          {t.blog.intro}
        </p>
      </div>

      <BlogCatalog lang={lang} client:load />
    </div>
  </main>

  <Footer lang={lang} />
</Layout>
